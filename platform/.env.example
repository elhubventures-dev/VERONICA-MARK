# VERONICA MARK Platform — Environment Variables
# Copy to .env.local for local development. Never commit secrets.

# ─── Application ───────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VERONICA MARK

# ─── Database (Neon PostgreSQL) ─────────────────────────────
# Pooled connection for the app runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Direct (non-pooled) connection for Prisma migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Auth.js / NextAuth ─────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-generated-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Supabase Storage ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=veronica-mark-media

# ─── Redis (Upstash) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Payments (Paystack) ────────────────────────────────────
# Secret key is required for initialize / verify / webhooks (sk_test_… or sk_live_…)
PAYSTACK_SECRET_KEY=
# Optional public key (pk_test_… / pk_live_…) for future inline JS; redirect flow uses secret server-side
PAYSTACK_PUBLIC_KEY=
# Webhook URL to register in Paystack Dashboard:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/paystack
# SquadCo reserved for a later phase (not used in checkout)
SQUADCO_SECRET_KEY=
SQUADCO_PUBLIC_KEY=

# USD → NGN for international shipping ($50) and display FX ($1 = ₦1,500).
# Catalog prices stay in NGN; international browsers see USD at this rate.
USD_NGN_RATE=1500

# Optional local override for geo (ISO2), e.g. US — useful without Vercel geo headers
# GEO_COUNTRY_OVERRIDE=US

# ─── Email (Resend) ─────────────────────────────────────────
# API key from https://resend.com/api-keys (re_…)
RESEND_API_KEY=
# Verified sender, e.g. VERONICA MARK <noreply@yourdomain.com>
# For Resend sandbox testing you can use: VERONICA MARK <onboarding@resend.dev>
EMAIL_FROM=VERONICA MARK <onboarding@resend.dev>

# ─── Cron / workers ─────────────────────────────────────────
# Shared secret for Vercel Cron + manual worker calls (Authorization: Bearer …)
CRON_SECRET=

# ─── Logging / Observability ────────────────────────────────
LOG_LEVEL=info
# Sentry — create a Next.js project at https://sentry.io then paste DSNs
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional source-map upload (CI/CD only)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Seed (non-production only) ─────────────────────────────
# Required for staging/preview seeds. Local development may omit (demo fallback).
# SEED_DEFAULT_PASSWORD=
