generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Stage 3 resolution: User.role remains the coarse, additive role while
// UserRoleAssignment wires users to extensible Role/Permission records.
enum UserRole {
  SUPER_ADMIN
  BRAND_MANAGER
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  OUT_OF_STOCK
  ARCHIVED
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
  DISCONTINUED
}

enum Currency {
  NGN
  USD
  GBP
  EUR
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum LanguageCode {
  EN
  FR
  DE
  ES
  IT
  PT
  NL
}

// Stage 3 resolution: the complete SRS lifecycle is authoritative.
enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  SQUADCO
}

enum ShippingProvider {
  DHL
  FEDEX
  UPS
  LOCAL_COURIER
  MANUAL
}

enum ShippingStatus {
  PENDING
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
  EXHAUSTED
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  PUSH
  IN_APP
  SMS
}

enum PermissionScope {
  READ
  WRITE
  DELETE
  MANAGE
}

enum BrandStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AddressType {
  BILLING
  SHIPPING
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  INSPECTED
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReviewModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum InventoryMovementType {
  RECEIPT
  SALE
  RETURN
  RESERVATION
  RELEASE
  ADJUSTMENT
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
  EXPIRY
}

enum RewardTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRY
  REVERSAL
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReportFormat {
  CSV
  XLSX
  PDF
  JSON
}

enum FeatureFlagEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum TaxType {
  VAT
  SALES_TAX
  GST
  DUTY
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum CMSSectionType {
  HERO
  RICH_TEXT
  IMAGE
  VIDEO
  PRODUCT_GRID
  BRAND_GRID
  TESTIMONIALS
  FAQ
  CUSTOM
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum StockReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum ReferralInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ReferralRewardStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum ReportStatus {
  QUEUED
  GENERATING
  READY
  FAILED
  EXPIRED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum OrderNoteVisibility {
  INTERNAL
  CUSTOMER
}

enum FlashSaleStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@index([expires])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  emailVerified         DateTime?
  passwordHash          String?
  firstName             String
  lastName              String
  phone                 String?
  image                 String?
  avatar                String?
  role                  UserRole               @default(CUSTOMER)
  preferredCurrency     Currency               @default(NGN)
  lastLoginAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  accounts              Account[]
  sessions              Session[]
  passwordResetTokens   PasswordResetToken[]
  preference            UserPreference?
  customerProfile       CustomerProfile?
  brandManagerProfile   BrandManagerProfile?
  superAdminProfile     SuperAdminProfile?
  roleAssignments       UserRoleAssignment[]
  auditLogs             AuditLog[]             @relation("AuditActor")
  reports               Report[]
  supportTickets        SupportTicket[]        @relation("TicketRequester")
  supportMessages       SupportTicketMessage[]
  inventoryMovements    InventoryMovement[]    @relation("MovementActor")
  orderStatusChanges    OrderStatusHistory[]
  orderNotes            OrderNote[]
  productMediaUploads   ProductMedia[]         @relation("ProductMediaUploader")
  mediaUploads          MediaAsset[]           @relation("MediaUploader")
  notificationTemplates NotificationTemplate[] @relation("NotificationTemplateUpdater")
  emailTemplates        EmailTemplate[]        @relation("EmailTemplateUpdater")
  scheduledTaskRuns     ScheduledTaskRun[]     @relation("TaskTriggerUser")

  @@index([role, deletedAt])
  @@index([emailVerified])
}

model UserPreference {
  id               String       @id @default(uuid())
  userId           String       @unique
  theme            Theme        @default(SYSTEM)
  language         LanguageCode @default(EN)
  currency         Currency     @default(NGN)
  timezone         String       @default("UTC")
  marketingConsent Boolean      @default(false)
  analyticsConsent Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([language, currency])
}

model CustomerProfile {
  id                     String                  @id @default(uuid())
  userId                 String                  @unique
  dateOfBirth            DateTime?
  gender                 String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses              Address[]
  carts                  Cart[]
  orders                 Order[]
  rewardAccount          RewardAccount?
  wallets                Wallet[]
  wishlists              Wishlist[]
  reviews                Review[]
  reviewHelpfulVotes     ReviewHelpfulVote[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  recentlyViewed         RecentlyViewed[]
  comparisonLists        ComparisonList[]
  referralCodes          ReferralCode[]
  referralInvitations    ReferralInvitation[]    @relation("ReferralInviteeCustomer")
  referralRewards        ReferralReward[]
  couponUsages           CouponUsage[]
  stockReservations      StockReservation[]
  returnRequests         ReturnRequest[]
  abandonedCarts         AbandonedCart[]

  @@index([deletedAt, createdAt])
}

model BrandManagerProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  brandId   String
  title     String?
  isPrimary Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@index([brandId, deletedAt])
}

model SuperAdminProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@index([deletedAt, isSystem])
}

model Permission {
  id          String           @id @default(uuid())
  resource    String
  scope       PermissionScope
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  roles       RolePermission[]

  @@unique([resource, scope])
  @@index([deletedAt])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String    @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId, deletedAt])
}

model Brand {
  id            String                @id @default(uuid())
  name          String
  slug          String                @unique
  description   String?               @db.Text
  logo          String?
  banner        String?
  country       String
  featured      Boolean               @default(false)
  status        BrandStatus           @default(PENDING)
  contactEmail  String?
  contactPhone  String?
  website       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deletedAt     DateTime?
  managers      BrandManagerProfile[]
  socialLinks   BrandSocialLink[]
  products      Product[]
  promotions    PromotionBrand[]
  shippingRules ShippingRule[]

  @@index([status, featured, deletedAt])
  @@index([country, status])
}

model BrandSocialLink {
  id        String    @id @default(uuid())
  brandId   String
  platform  String
  url       String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, platform])
  @@index([brandId, sortOrder, deletedAt])
}

model Category {
  id           String                @id @default(uuid())
  name         String
  slug         String                @unique
  description  String?               @db.Text
  image        String?
  parentId     String?
  sortOrder    Int                   @default(0)
  featured     Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]
  promotions   PromotionCategory[]

  @@index([parentId, sortOrder, deletedAt])
  @@index([featured, deletedAt])
}

model CategoryTranslation {
  id          String       @id @default(uuid())
  categoryId  String
  language    LanguageCode
  name        String
  description String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@index([language, deletedAt])
}

model Product {
  id               String               @id @default(uuid())
  brandId          String
  categoryId       String
  name             String
  slug             String               @unique
  barcode          String?              @unique
  shortDescription String?
  description      String?              @db.Text
  status           ProductStatus        @default(DRAFT)
  visible          Boolean              @default(false)
  publishedAt      DateTime?
  featured         Boolean              @default(false)
  newArrival       Boolean              @default(false)
  bestSeller       Boolean              @default(false)
  preorderEnabled  Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  brand            Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category         Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  media            ProductMedia[]
  seo              ProductSEO?
  translations     ProductTranslation[]
  attributes       ProductAttribute[]
  tags             ProductTag[]
  promotionTargets PromotionProduct[]
  flashSaleItems   FlashSaleItem[]
  wishlistItems    WishlistItem[]
  reviews          Review[]
  comparisonItems  ComparisonItem[]
  recentlyViewed   RecentlyViewed[]
  analyticsEvents  AnalyticsEvent[]

  @@index([brandId, status, deletedAt])
  @@index([categoryId, status, deletedAt])
  @@index([visible, featured, publishedAt])
  @@index([newArrival, bestSeller, deletedAt])
}

model ProductVariant {
  id                 String                  @id @default(uuid())
  productId          String
  sku                String                  @unique
  barcode            String?                 @unique
  /// Purchase / wholesale cost (NGN). Not shown to customers.
  costPrice          Decimal?                @db.Decimal(12, 2)
  /// Customer-facing selling price (NGN).
  price              Decimal                 @db.Decimal(12, 2)
  salePrice          Decimal?                @db.Decimal(12, 2)
  weightGrams        Int?
  sizeLabel          String?
  colorLabel         String?
  active             Boolean                 @default(true)
  sortOrder          Int                     @default(0)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  product            Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues    ProductAttributeValue[]
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  reservations       StockReservation[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  flashSaleItems     FlashSaleItem[]

  @@index([productId, active, deletedAt])
  @@index([price, salePrice])
}

model ProductMedia {
  id         String    @id @default(uuid())
  productId  String
  uploadedBy String?
  type       MediaType @default(IMAGE)
  url        String
  altText    String?
  sortOrder  Int       @default(0)
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploader   User?     @relation("ProductMediaUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder, deletedAt])
  @@index([uploadedBy])
}

model ProductSEO {
  id              String    @id @default(uuid())
  productId       String    @unique
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  keywords        String[]
  structuredData  Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductTranslation {
  id               String       @id @default(uuid())
  productId        String
  language         LanguageCode
  name             String
  shortDescription String?
  description      String?      @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
  @@index([language, deletedAt])
}

model ProductAttribute {
  id        String                  @id @default(uuid())
  productId String
  name      String
  sortOrder Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  deletedAt DateTime?
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductAttributeValue[]

  @@unique([productId, name])
  @@index([productId, sortOrder, deletedAt])
}

model ProductAttributeValue {
  id          String           @id @default(uuid())
  attributeId String
  variantId   String
  value       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variant     ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([attributeId, variantId])
  @@index([variantId, deletedAt])
}

model Tag {
  id        String       @id @default(uuid())
  name      String       @unique
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  products  ProductTag[]

  @@index([deletedAt])
}

model ProductTag {
  id        String   @id @default(uuid())
  productId String
  tagId     String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId])
}

model Inventory {
  id              String          @id @default(uuid())
  variantId       String          @unique
  available       Int             @default(0)
  reserved        Int             @default(0)
  incoming        Int             @default(0)
  reorderLevel    Int             @default(5)
  status          InventoryStatus @default(OUT_OF_STOCK)
  preorderEnabled Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([status, available])
  @@index([preorderEnabled, deletedAt])
}

model InventoryMovement {
  id            String                @id @default(uuid())
  variantId     String
  actorId       String?
  type          InventoryMovementType
  quantity      Int
  balanceAfter  Int
  referenceType String?
  referenceId   String?
  reason        String?
  metadata      Json?
  createdAt     DateTime              @default(now())
  variant       ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor         User?                 @relation("MovementActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
}

model StockReservation {
  id          String                 @id @default(uuid())
  variantId   String
  customerId  String?
  cartItemId  String?
  orderItemId String?
  quantity    Int
  status      StockReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?
  variant     ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customer    CustomerProfile?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartItem    CartItem?              @relation(fields: [cartItemId], references: [id], onDelete: SetNull)
  orderItem   OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([variantId, status, expiresAt])
  @@index([customerId, status])
  @@index([cartItemId])
  @@index([orderItemId])
}

model Cart {
  id         String           @id @default(uuid())
  customerId String?
  sessionId  String?          @unique
  currency   Currency         @default(NGN)
  expiresAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  customer   CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  abandoned  AbandonedCart?

  @@index([customerId, deletedAt])
  @@index([expiresAt])
}

model CartItem {
  id           String             @id @default(uuid())
  cartId       String
  variantId    String
  quantity     Int
  unitPrice    Decimal            @db.Decimal(12, 2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  cart         Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant      ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  reservations StockReservation[]

  @@unique([cartId, variantId])
  @@index([variantId, deletedAt])
}

model Address {
  id         String          @id @default(uuid())
  customerId String
  type       AddressType
  fullName   String
  phone      String
  company    String?
  country    String
  region     String?
  state      String
  city       String
  address1   String
  address2   String?
  postalCode String?
  latitude   Decimal?        @db.Decimal(10, 7)
  longitude  Decimal?        @db.Decimal(10, 7)
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, type, isDefault, deletedAt])
  @@index([country, state, city])
}

model Order {
  id                 String               @id @default(uuid())
  orderNumber        String               @unique
  customerId         String
  couponId           String?
  currency           Currency
  subtotal           Decimal              @db.Decimal(12, 2)
  tax                Decimal              @db.Decimal(12, 2)
  shippingFee        Decimal              @db.Decimal(12, 2)
  discount           Decimal              @default(0) @db.Decimal(12, 2)
  total              Decimal              @db.Decimal(12, 2)
  status             OrderStatus          @default(PENDING)
  notes              String?              @db.Text
  billingAddress     Json
  shippingAddress    Json
  placedAt           DateTime?
  cancelledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  customer           CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  coupon             Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  orderNotes         OrderNote[]
  payments           Payment[]
  shipments          ShippingShipment[]
  returnRequests     ReturnRequest[]
  refunds            Refund[]
  couponUsages       CouponUsage[]
  walletTransactions WalletTransaction[]
  rewardTransactions RewardTransaction[]
  referralRewards    ReferralReward[]

  @@index([customerId, status, createdAt])
  @@index([status, createdAt])
  @@index([couponId])
  @@index([deletedAt])
}

model OrderItem {
  id                  String             @id @default(uuid())
  orderId             String
  variantId           String
  productName         String
  variantName         String?
  sku                 String
  quantity            Int
  unitPrice           Decimal            @db.Decimal(12, 2)
  compareAtPrice      Decimal?           @db.Decimal(12, 2)
  taxAmount           Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal            @default(0) @db.Decimal(12, 2)
  lineTotal           Decimal            @db.Decimal(12, 2)
  preorderEstimatedAt DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  order               Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems         ReturnItem[]
  reservations        StockReservation[]

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  changedBy  String?
  fromStatus OrderStatus?
  toStatus   OrderStatus
  comment    String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      User?        @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedBy, createdAt])
}

model OrderNote {
  id         String              @id @default(uuid())
  orderId    String
  authorId   String?
  visibility OrderNoteVisibility @default(INTERNAL)
  content    String              @db.Text
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author     User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orderId, visibility, createdAt])
  @@index([authorId])
}

model Payment {
  id                 String          @id @default(uuid())
  orderId            String
  provider           PaymentProvider
  reference          String          @unique
  status             PaymentStatus   @default(PENDING)
  amount             Decimal         @db.Decimal(12, 2)
  currency           Currency
  authorizationCode  String?
  providerCustomerId String?
  paidAt             DateTime?
  failureReason      String?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events             PaymentEvent[]
  refunds            Refund[]

  @@index([orderId, status])
  @@index([provider, status, createdAt])
}

model PaymentEvent {
  id              String          @id @default(uuid())
  paymentId       String?
  provider        PaymentProvider
  providerEventId String
  eventType       String
  payload         Json
  signature       String?
  status          WebhookStatus   @default(RECEIVED)
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime        @default(now())
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, createdAt])
  @@index([status, createdAt])
}

model ShippingShipment {
  id                  String                  @id @default(uuid())
  orderId             String
  provider            ShippingProvider
  providerShipmentId  String?
  trackingNumber      String?                 @unique
  status              ShippingStatus          @default(PENDING)
  shippingMethod      String?
  cost                Decimal                 @default(0) @db.Decimal(12, 2)
  estimatedDeliveryAt DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  metadata            Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?
  order               Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  trackingEvents      ShipmentTrackingEvent[]

  @@index([orderId, status])
  @@index([provider, status, createdAt])
}

model ShippingRule {
  id              String    @id @default(uuid())
  brandId         String?
  name            String
  country         String
  region          String?
  minOrderAmount  Decimal?  @db.Decimal(12, 2)
  maxOrderAmount  Decimal?  @db.Decimal(12, 2)
  minWeightGrams  Int?
  maxWeightGrams  Int?
  fee             Decimal   @db.Decimal(12, 2)
  freeAboveAmount Decimal?  @db.Decimal(12, 2)
  active          Boolean   @default(true)
  priority        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  brand           Brand?    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([country, region, active, priority])
  @@index([brandId, active, deletedAt])
}

model ShipmentTrackingEvent {
  id          String           @id @default(uuid())
  shipmentId  String
  status      ShippingStatus
  description String?
  location    String?
  occurredAt  DateTime
  payload     Json?
  createdAt   DateTime         @default(now())
  shipment    ShippingShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@index([status, occurredAt])
}

model TaxRule {
  id            String    @id @default(uuid())
  country       String
  region        String?
  taxType       TaxType
  name          String
  rate          Decimal   @db.Decimal(7, 4)
  inclusive     Boolean   @default(false)
  active        Boolean   @default(true)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([country, region, taxType, active])
  @@index([effectiveFrom, effectiveTo])
}

model ReturnRequest {
  id           String          @id @default(uuid())
  orderId      String
  customerId   String
  returnNumber String          @unique
  reason       String
  details      String?         @db.Text
  status       ReturnStatus    @default(REQUESTED)
  requestedAt  DateTime        @default(now())
  approvedAt   DateTime?
  receivedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items        ReturnItem[]
  refunds      Refund[]

  @@index([orderId, status])
  @@index([customerId, status, requestedAt])
}

model ReturnItem {
  id              String        @id @default(uuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  reason          String
  condition       String?
  resolution      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

model Refund {
  id                String         @id @default(uuid())
  orderId           String
  paymentId         String?
  returnRequestId   String?
  reference         String         @unique
  status            RefundStatus   @default(PENDING)
  amount            Decimal        @db.Decimal(12, 2)
  currency          Currency
  reason            String
  providerReference String?
  processedAt       DateTime?
  failureReason     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment           Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  returnRequest     ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([paymentId])
  @@index([returnRequestId])
}

model Promotion {
  id                    String              @id @default(uuid())
  name                  String
  description           String?             @db.Text
  type                  PromotionType
  value                 Decimal             @db.Decimal(12, 2)
  minimumOrderAmount    Decimal?            @db.Decimal(12, 2)
  maximumDiscount       Decimal?            @db.Decimal(12, 2)
  buyQuantity           Int?
  getQuantity           Int?
  priority              Int                 @default(0)
  stackable             Boolean             @default(false)
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usedCount             Int                 @default(0)
  status                PromotionStatus     @default(DRAFT)
  startsAt              DateTime
  endsAt                DateTime
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?
  brands                PromotionBrand[]
  categories            PromotionCategory[]
  products              PromotionProduct[]
  coupons               Coupon[]

  @@index([status, startsAt, endsAt])
  @@index([priority, stackable, deletedAt])
}

model PromotionBrand {
  id          String    @id @default(uuid())
  promotionId String
  brandId     String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([promotionId, brandId])
  @@index([brandId])
}

model PromotionCategory {
  id          String    @id @default(uuid())
  promotionId String
  categoryId  String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, categoryId])
  @@index([categoryId])
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String
  productId   String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId])
}

model Coupon {
  id                    String        @id @default(uuid())
  promotionId           String
  code                  String        @unique
  status                CouponStatus  @default(ACTIVE)
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usedCount             Int           @default(0)
  startsAt              DateTime?
  expiresAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  promotion             Promotion     @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  orders                Order[]
  usages                CouponUsage[]

  @@index([promotionId, status])
  @@index([status, startsAt, expiresAt])
}

model CouponUsage {
  id         String          @id @default(uuid())
  couponId   String
  customerId String
  orderId    String
  discount   Decimal         @db.Decimal(12, 2)
  usedAt     DateTime        @default(now())
  coupon     Coupon          @relation(fields: [couponId], references: [id], onDelete: Restrict)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([couponId, orderId])
  @@index([customerId, couponId, usedAt])
  @@index([orderId])
}

model FlashSale {
  id        String          @id @default(uuid())
  name      String
  status    FlashSaleStatus @default(DRAFT)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
  items     FlashSaleItem[]

  @@index([status, startsAt, endsAt])
}

model FlashSaleItem {
  id            String          @id @default(uuid())
  flashSaleId   String
  productId     String
  variantId     String?
  salePrice     Decimal         @db.Decimal(12, 2)
  quantityLimit Int?
  soldCount     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  flashSale     FlashSale       @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([flashSaleId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model RewardAccount {
  id               String              @id @default(uuid())
  customerId       String              @unique
  balance          Int                 @default(0)
  lifetimeEarned   Int                 @default(0)
  lifetimeRedeemed Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  customer         CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions     RewardTransaction[]

  @@index([balance, deletedAt])
}

model RewardTransaction {
  id           String                @id @default(uuid())
  accountId    String
  orderId      String?
  type         RewardTransactionType
  points       Int
  balanceAfter Int
  reason       String
  expiresAt    DateTime?
  metadata     Json?
  createdAt    DateTime              @default(now())
  account      RewardAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([orderId])
  @@index([type, expiresAt])
}

model RewardRule {
  id           String    @id @default(uuid())
  name         String
  eventType    String
  points       Int
  multiplier   Decimal?  @db.Decimal(8, 4)
  minimumSpend Decimal?  @db.Decimal(12, 2)
  active       Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([eventType, active])
  @@index([startsAt, endsAt])
}

model Wallet {
  id           String              @id @default(uuid())
  customerId   String
  currency     Currency
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  customer     CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@unique([customerId, currency])
  @@index([currency, deletedAt])
}

model WalletTransaction {
  id           String                @id @default(uuid())
  walletId     String
  orderId      String?
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(12, 2)
  balanceAfter Decimal               @db.Decimal(12, 2)
  reference    String                @unique
  description  String?
  metadata     Json?
  createdAt    DateTime              @default(now())
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
}

model ReferralCode {
  id          String               @id @default(uuid())
  customerId  String
  code        String               @unique
  active      Boolean              @default(true)
  usageLimit  Int?
  usedCount   Int                  @default(0)
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  deletedAt   DateTime?
  customer    CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invitations ReferralInvitation[]

  @@index([customerId, active, deletedAt])
}

model ReferralInvitation {
  id                String                   @id @default(uuid())
  referralCodeId    String
  inviteeCustomerId String?
  email             String
  status            ReferralInvitationStatus @default(PENDING)
  acceptedAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?
  referralCode      ReferralCode             @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  inviteeCustomer   CustomerProfile?         @relation("ReferralInviteeCustomer", fields: [inviteeCustomerId], references: [id], onDelete: SetNull)
  rewards           ReferralReward[]

  @@unique([referralCodeId, email])
  @@index([email, status])
  @@index([inviteeCustomerId])
}

model ReferralReward {
  id           String               @id @default(uuid())
  invitationId String
  customerId   String
  orderId      String?
  status       ReferralRewardStatus @default(PENDING)
  amount       Decimal?             @db.Decimal(12, 2)
  points       Int?
  currency     Currency?
  awardedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  invitation   ReferralInvitation   @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  customer     CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order        Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, status, createdAt])
  @@index([invitationId])
  @@index([orderId])
}

model Wishlist {
  id         String          @id @default(uuid())
  customerId String
  name       String          @default("My Wishlist")
  isDefault  Boolean         @default(false)
  isPublic   Boolean         @default(false)
  shareToken String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      WishlistItem[]

  @@index([customerId, isDefault, deletedAt])
}

model WishlistItem {
  id         String    @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  wishlist   Wishlist  @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([wishlistId, productId])
  @@index([productId, deletedAt])
}

model Review {
  id               String                 @id @default(uuid())
  productId        String
  customerId       String
  rating           Int
  title            String?
  content          String?                @db.Text
  verifiedPurchase Boolean                @default(false)
  moderationStatus ReviewModerationStatus @default(PENDING)
  moderatedAt      DateTime?
  helpfulCount     Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  product          Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer         CustomerProfile        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  media            ReviewMedia[]
  helpfulVotes     ReviewHelpfulVote[]

  @@unique([productId, customerId])
  @@index([productId, moderationStatus, createdAt])
  @@index([customerId, deletedAt])
  @@index([rating, moderationStatus])
}

model ReviewMedia {
  id        String    @id @default(uuid())
  reviewId  String
  type      MediaType @default(IMAGE)
  url       String
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  review    Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, sortOrder, deletedAt])
}

model ReviewHelpfulVote {
  id         String          @id @default(uuid())
  reviewId   String
  customerId String
  helpful    Boolean         @default(true)
  createdAt  DateTime        @default(now())
  review     Review          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([reviewId, customerId])
  @@index([customerId])
}

model ComparisonList {
  id         String           @id @default(uuid())
  customerId String
  name       String           @default("Comparison")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?
  customer   CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      ComparisonItem[]

  @@index([customerId, deletedAt])
}

model ComparisonItem {
  id               String         @id @default(uuid())
  comparisonListId String
  productId        String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  comparisonList   ComparisonList @relation(fields: [comparisonListId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([comparisonListId, productId])
  @@index([productId, deletedAt])
}

model RecentlyViewed {
  id         String          @id @default(uuid())
  customerId String
  productId  String
  viewedAt   DateTime        @default(now())
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId])
  @@index([customerId, viewedAt])
  @@index([productId, viewedAt])
}

model Notification {
  id         String              @id @default(uuid())
  customerId String
  channel    NotificationChannel
  title      String
  message    String              @db.Text
  actionUrl  String?
  metadata   Json?
  readAt     DateTime?
  sentAt     DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?
  customer   CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, readAt, createdAt])
  @@index([channel, sentAt])
}

model NotificationPreference {
  id           String          @id @default(uuid())
  customerId   String          @unique
  emailEnabled Boolean         @default(true)
  pushEnabled  Boolean         @default(true)
  inAppEnabled Boolean         @default(true)
  smsEnabled   Boolean         @default(false)
  orderUpdates Boolean         @default(true)
  promotions   Boolean         @default(true)
  loyalty      Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model NotificationTemplate {
  id        String              @id @default(uuid())
  updatedBy String?
  key       String
  channel   NotificationChannel
  language  LanguageCode        @default(EN)
  subject   String?
  body      String              @db.Text
  variables Json?
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  deletedAt DateTime?
  updater   User?               @relation("NotificationTemplateUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([key, channel, language])
  @@index([channel, active, deletedAt])
  @@index([updatedBy])
}

model CMSPage {
  id              String       @id @default(uuid())
  slug            String       @unique
  title           String
  language        LanguageCode @default(EN)
  metaTitle       String?
  metaDescription String?
  published       Boolean      @default(false)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?
  sections        CMSSection[]

  @@index([language, published, publishedAt])
  @@index([deletedAt])
}

model CMSSection {
  id        String         @id @default(uuid())
  pageId    String
  type      CMSSectionType
  name      String?
  content   Json
  sortOrder Int            @default(0)
  visible   Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  page      CMSPage        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder, visible, deletedAt])
}

model MediaAsset {
  id         String    @id @default(uuid())
  uploadedBy String?
  type       MediaType
  fileName   String
  url        String
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  altText    String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  uploader   User?     @relation("MediaUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([uploadedBy, deletedAt])
}

model EmailTemplate {
  id        String       @id @default(uuid())
  updatedBy String?
  key       String
  language  LanguageCode @default(EN)
  subject   String
  htmlBody  String       @db.Text
  textBody  String?      @db.Text
  variables Json?
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  updater   User?        @relation("EmailTemplateUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([key, language])
  @@index([active, deletedAt])
  @@index([updatedBy])
}

model AuditLog {
  id             String   @id @default(uuid())
  actorId        String?
  action         String
  resource       String
  recordId       String?
  previousValues Json?
  newValues      Json?
  outcome        String
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now())
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resource, recordId, createdAt])
  @@index([outcome, createdAt])
  @@index([requestId])
}

model FeatureFlag {
  id          String                 @id @default(uuid())
  key         String
  environment FeatureFlagEnvironment
  enabled     Boolean                @default(false)
  description String?
  rules       Json?
  rollout     Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  deletedAt   DateTime?

  @@unique([key, environment])
  @@index([environment, enabled, deletedAt])
}

model Localization {
  id        String       @id @default(uuid())
  language  LanguageCode
  namespace String
  key       String
  value     String       @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  @@unique([language, namespace, key])
  @@index([namespace, language, deletedAt])
}

model SystemSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       Json
  description String?
  isPublic    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isPublic, deletedAt])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  productId  String?
  eventName  String
  customerId String?
  sessionId  String?
  source     String?
  metadata   Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([eventName, occurredAt])
  @@index([customerId, occurredAt])
  @@index([productId, occurredAt])
  @@index([sessionId, occurredAt])
}

model Report {
  id           String       @id @default(uuid())
  generatedBy  String
  type         String
  format       ReportFormat
  status       ReportStatus @default(QUEUED)
  parameters   Json?
  fileUrl      String?
  errorMessage String?
  expiresAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  generator    User         @relation(fields: [generatedBy], references: [id], onDelete: Restrict)

  @@index([generatedBy, createdAt])
  @@index([type, status, createdAt])
}

model WebhookLog {
  id             String        @id @default(uuid())
  provider       String
  eventId        String?
  eventType      String
  endpoint       String?
  status         WebhookStatus @default(RECEIVED)
  statusCode     Int?
  requestHeaders Json?
  payload        Json
  responseBody   Json?
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@unique([provider, eventId])
  @@index([provider, status, createdAt])
  @@index([eventType, createdAt])
}

model BackgroundJob {
  id           String              @id @default(uuid())
  jobType      String
  queue        String              @default("default")
  status       BackgroundJobStatus @default(PENDING)
  payload      Json?
  result       Json?
  attempts     Int                 @default(0)
  maxAttempts  Int                 @default(3)
  scheduledAt  DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([queue, status, scheduledAt])
  @@index([jobType, status, createdAt])
}

model AbandonedCart {
  id             String           @id @default(uuid())
  cartId         String           @unique
  customerId     String?
  email          String?
  abandonedAt    DateTime
  recoveredAt    DateTime?
  reminderCount  Int              @default(0)
  lastReminderAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  cart           Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  customer       CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([customerId, recoveredAt])
  @@index([abandonedAt, recoveredAt, deletedAt])
}

model SupportTicket {
  id           String                 @id @default(uuid())
  requesterId  String
  ticketNumber String                 @unique
  subject      String
  description  String                 @db.Text
  status       SupportTicketStatus    @default(OPEN)
  priority     SupportTicketPriority  @default(NORMAL)
  category     String?
  assignedTo   String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?
  requester    User                   @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  messages     SupportTicketMessage[]

  @@index([requesterId, status, createdAt])
  @@index([status, priority, updatedAt])
  @@index([assignedTo, status])
}

model SupportTicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  authorId    String?
  message     String        @db.Text
  attachments Json?
  internal    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model ExchangeRate {
  id            String   @id @default(uuid())
  baseCurrency  Currency
  quoteCurrency Currency
  rate          Decimal  @db.Decimal(18, 8)
  effectiveAt   DateTime
  source        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency, effectiveAt])
  @@index([baseCurrency, quoteCurrency, effectiveAt])
}

model ApiUsageLog {
  id         String   @id @default(uuid())
  apiKeyId   String?
  userId     String?
  endpoint   String
  method     String
  statusCode Int
  durationMs Int
  requestId  String?
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([endpoint, createdAt])
  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([statusCode, createdAt])
}

model ScheduledTaskRun {
  id           String              @id @default(uuid())
  triggeredBy  String?
  taskName     String
  schedule     String?
  status       BackgroundJobStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  result       Json?
  errorMessage String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  triggerUser  User?               @relation("TaskTriggerUser", fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@index([taskName, status, createdAt])
  @@index([triggeredBy, createdAt])
}
